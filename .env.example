# Local defaults. Use absolute mounted-volume paths in Railway.
GLASSWING_RUNTIME_MODE=local
GLASSWING_DATA_ROOT=/absolute/path/to/data
GLASSWING_LOG_ROOT=/absolute/path/to/logs
GLASSWING_CLASSIFICATION_DB=/absolute/path/to/data/classifications.sqlite3
GLASSWING_MANUAL_SNAPSHOT_ROOT=/absolute/path/to/data/manual/snapshots

# Existing crawler storage can move independently.
AI_SEARCH_DB=/absolute/path/to/ai-search.sqlite3
AI_SEARCH_HTML_ARCHIVE=/absolute/path/to/ai-html
ZONE_UNIVERSE_DB=/absolute/path/to/zone-universe.sqlite3
ZONE_UNIVERSE_DATA_ROOT=/absolute/path/to/zone-data
ZONE_UNIVERSE_LOG_ROOT=/absolute/path/to/zone-logs
ZONE_UNIVERSE_HTML_ARCHIVE=/absolute/path/to/zone-html

# In cloud mode, Railway or another orchestrator owns worker lifecycle.
# The System Health page becomes read-only for process controls.
# GLASSWING_RUNTIME_MODE=cloud
