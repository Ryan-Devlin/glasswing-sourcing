# Local defaults. Use absolute mounted-volume paths in Railway.
GLASSWING_RUNTIME_MODE=local
GLASSWING_DATA_ROOT=/absolute/path/to/data
GLASSWING_LOG_ROOT=/absolute/path/to/logs
GLASSWING_CLASSIFICATION_DB=/absolute/path/to/data/classifications.sqlite3
GLASSWING_MANUAL_SNAPSHOT_ROOT=/absolute/path/to/data/manual/snapshots

# Existing crawler storage can move independently.
AI_SEARCH_DB=/absolute/path/to/ai-search.sqlite3
AI_SEARCH_HTML_ARCHIVE=/absolute/path/to/ai-html
AI_SEARCH_RETAIN_RAW_HTML=0
ZONE_UNIVERSE_DB=/absolute/path/to/zone-universe.sqlite3
ZONE_UNIVERSE_DATA_ROOT=/absolute/path/to/zone-data
ZONE_UNIVERSE_LOG_ROOT=/absolute/path/to/zone-logs
ZONE_UNIVERSE_HTML_ARCHIVE=/absolute/path/to/zone-html
ZONE_UNIVERSE_RETAIN_RAW_HTML=0
GLASSWING_RETENTION_MIN_SCORE=25
# Full all-screened/screened-out CSV mirrors are disabled automatically when
# the canonical classification store is PostgreSQL. Set to 1 only for a
# legacy external consumer; normal cloud UI/downloads query PostgreSQL.
GLASSWING_BULK_CSV_EXPORTS=0

# In cloud mode, Railway or another orchestrator owns worker lifecycle.
# The System Health page becomes read-only for process controls.
# GLASSWING_RUNTIME_MODE=cloud

# Classification store backend selector. Unset (default) keeps SQLite at
# GLASSWING_CLASSIFICATION_DB. Setting this switches classification_store.py,
# training_truth.py, rejection_cleanup.py, model_evaluation.py, and
# health_monitor.py to PostgreSQL -- same schema, chosen purely by this
# variable's presence, so local SQLite mode is never removed.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Object storage backend selector for manual snapshots. Unset (default) keeps
# snapshots as local files under GLASSWING_MANUAL_SNAPSHOT_ROOT. Setting
# S3_BUCKET switches manual_truth_backup.py to any S3-compatible provider
# (AWS S3, Cloudflare R2, MinIO, ...). S3_ENDPOINT_URL is only needed for
# non-AWS providers (e.g. R2's account-specific endpoint).
# S3_BUCKET=glasswing-sourcing-archives
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Each of these is its own dedicated Postgres backend selector -- never the
# same variable as DATABASE_URL above (which is already set in production
# for the classification store), so enabling one cloud backend never
# silently switches another one on too. All are gated + schema-namespaced
# the same way (own CREATE SCHEMA + SET search_path), so they can safely
# point at the very same physical Postgres instance as DATABASE_URL without
# their tables colliding.
# PIPELINE_DATABASE_URL=postgresql://user:password@host:5432/dbname
# AI_SEARCH_DATABASE_URL=postgresql://user:password@host:5432/dbname
# ZONE_UNIVERSE_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional low-noise daily sourcing digest. Deploy daily_digest.py as a
# short-lived cron job; never place real SMTP passwords in this file.
# DIGEST_EMAIL_TO=recipient@example.com
# DIGEST_EMAIL_FROM=sender@example.com
# DIGEST_SMTP_HOST=smtp.example.com
# DIGEST_SMTP_PORT=587
# DIGEST_SMTP_USERNAME=sender@example.com
# DIGEST_SMTP_PASSWORD=
# DIGEST_SMTP_STARTTLS=true
# DIGEST_SMTP_SSL=false
# DIGEST_APP_URL=https://your-app.example.com
# DIGEST_MIN_SCORE=75
# DIGEST_MIN_CONFIDENCE=80
# DIGEST_MIN_CLAUDE_SCORE=70
# DIGEST_LOOKBACK_HOURS=24
# DIGEST_MAX_COMPANIES=5
# DIGEST_AUTO_CLAUDE=true
# DIGEST_CLAUDE_MAX_CALLS=5
# ANTHROPIC_API_KEY=
# DIGEST_TIMEZONE=America/New_York
