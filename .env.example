# Local defaults. Use absolute mounted-volume paths in Railway.
GLASSWING_RUNTIME_MODE=local
GLASSWING_DATA_ROOT=/absolute/path/to/data
GLASSWING_LOG_ROOT=/absolute/path/to/logs
GLASSWING_CLASSIFICATION_DB=/absolute/path/to/data/classifications.sqlite3
GLASSWING_MANUAL_SNAPSHOT_ROOT=/absolute/path/to/data/manual/snapshots

# Existing crawler storage can move independently.
AI_SEARCH_DB=/absolute/path/to/ai-search.sqlite3
AI_SEARCH_HTML_ARCHIVE=/absolute/path/to/ai-html
ZONE_UNIVERSE_DB=/absolute/path/to/zone-universe.sqlite3
ZONE_UNIVERSE_DATA_ROOT=/absolute/path/to/zone-data
ZONE_UNIVERSE_LOG_ROOT=/absolute/path/to/zone-logs
ZONE_UNIVERSE_HTML_ARCHIVE=/absolute/path/to/zone-html

# In cloud mode, Railway or another orchestrator owns worker lifecycle.
# The System Health page becomes read-only for process controls.
# GLASSWING_RUNTIME_MODE=cloud

# Classification store backend selector. Unset (default) keeps SQLite at
# GLASSWING_CLASSIFICATION_DB. Setting this switches classification_store.py,
# training_truth.py, rejection_cleanup.py, model_evaluation.py, and
# health_monitor.py to PostgreSQL -- same schema, chosen purely by this
# variable's presence, so local SQLite mode is never removed.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Object storage backend selector for manual snapshots. Unset (default) keeps
# snapshots as local files under GLASSWING_MANUAL_SNAPSHOT_ROOT. Setting
# S3_BUCKET switches manual_truth_backup.py to any S3-compatible provider
# (AWS S3, Cloudflare R2, MinIO, ...). S3_ENDPOINT_URL is only needed for
# non-AWS providers (e.g. R2's account-specific endpoint).
# S3_BUCKET=glasswing-sourcing-archives
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
